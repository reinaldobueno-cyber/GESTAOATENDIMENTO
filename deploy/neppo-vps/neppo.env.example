# Copie para /etc/gestao-atendimento/neppo.env na VPS.
# Nao commitar o arquivo real com segredos.

NEPPO_CLIENT_KEY=
NEPPO_CLIENT_SECRET=
NEPPO_USERNAME=
NEPPO_PASSWORD=

# Opcional. Deixe vazio se usar usuario/senha + client key/secret.
NEPPO_TOKEN=

# Opcional: ajuste se mudar a pasta do projeto na VPS.
GESTAO_REPO_DIR=/opt/gestao-atendimento

# Opcional: ano do painel.
GESTAO_DASHBOARD_YEAR=2026
