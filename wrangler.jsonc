{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestaoatendimento",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "ADJUSTMENTS",
      "id": "f5322e1c79514687ab28ebbf91837c25"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
