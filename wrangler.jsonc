{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestaoatendimento",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "ADJUSTMENTS",
      "id": "f5322e1c79514687ab28ebbf91837c25"
    }
  ],
  "d1_databases": [
    {
      "binding": "REVIEWS_DB",
      "database_name": "gestaoatendimento-reviews",
      "database_id": "58a287c6-3799-4cba-b76e-2941f04f782e"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
